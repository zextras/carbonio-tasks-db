  "AGPL-3.0-only"
)
url="https://github.com/zextras"
depends__apt=(
  "service-discover"
  "pending-setups"
  "carbonio-core"
  "postgresql-client"
)

depends__yum=(
  "service-discover"
  "pending-setups"
  "carbonio-core"
  "postgresql"
)

source=(
  "111-${pkgname}-setup.sh"
  "${pkgname}.hcl"
  "${pkgname}-bootstrap"
  "${pkgname}-setup"
  "${pkgname}-sidecar.service"
  "${pkgname}-sidecar-legacy.service"
  "intentions.json"
  "policies.json"
  "service-protocol.json"
)
backup=(
  "etc/zextras/service-discover/${pkgname}.hcl"
)

