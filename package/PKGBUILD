_package_common() {
  install -Dm644 "${srcdir}/111-${pkgname}-setup.sh" \
    "${pkgdir}/etc/zextras/pending-setups.d/111-${pkgname}-setup.sh"

  install -Dm755 "${srcdir}/${pkgname}-setup" \
    "${pkgdir}/usr/bin/${pkgname}-setup"

  install -Dm755 "${srcdir}/${pkgname}-bootstrap" \
    "${pkgdir}/usr/bin/${pkgname}-bootstrap"

  install -Dm644 "${srcdir}/${pkgname}-template.hcl" \
    "${pkgdir}/etc/zextras/service-discover/templates/${pkgname}-template.hcl"
  install -Dm755 "${srcdir}/${pkgname}-hcl" \
    "${pkgdir}/usr/bin/${pkgname}-hcl"

  install -Dm644 "${srcdir}/intentions.json" \
    "${pkgdir}/etc/carbonio/tasks-db/service-discover/intentions.json"

  install -Dm644 "${srcdir}/policies.json" \
    "${pkgdir}/etc/carbonio/tasks-db/service-discover/policies.json"

  install -Dm644 "${srcdir}/service-protocol.json" \
    "${pkgdir}/etc/carbonio/tasks-db/service-discover/service-protocol.json"
}

_package_systemd() {
  _package_common
  install -Dm644 "${srcdir}/${pkgname}-sidecar.service" \
    "${pkgdir}/lib/systemd/system/${pkgname}-sidecar.service"
}

_package_legacy() {
  _package_common
  install -Dm644 "${srcdir}/${pkgname}-sidecar-legacy.service" \
    "${pkgdir}/lib/systemd/system/${pkgname}-sidecar.service"
}

package() { _package_systemd; }
package__rocky_8() { _package_legacy; }
package__ubuntu_jammy() { _package_legacy; }

postinst() {
  getent group 'carbonio-tasks-db' >/dev/null ||
    groupadd -r 'carbonio-tasks-db'
  getent passwd 'carbonio-tasks-db' >/dev/null ||
    useradd -r -M -g 'carbonio-tasks-db' -s /sbin/nologin 'carbonio-tasks-db'

  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
    systemctl enable carbonio-tasks-db-sidecar.service >/dev/null 2>&1 || :
  fi

  if [ "$1" = "configure" ]; then
    carbonio-tasks-db-hcl migrate || :
    carbonio-tasks-db-hcl render || echo "WARNING: hcl render failed, run carbonio-tasks-db-setup"
  fi

  echo "======================================================"
  echo "Carbonio Tasks DB installed successfully!             "
  echo "You must run pending-setups to configure it correctly."
  echo "======================================================"
}

posttrans() {
  carbonio-tasks-db-hcl migrate || :
  carbonio-tasks-db-hcl render || echo "WARNING: hcl render failed, run carbonio-tasks-db-setup"
}

prerm() {
  if [ -d /run/systemd/system ]; then
    systemctl disable --now carbonio-tasks-db-sidecar.service >/dev/null 2>&1 || :
  fi
}

postrm() {
  rm -f /etc/zextras/service-discover/carbonio-tasks-db.hcl
  if [ "$1" = "purge" ]; then
    rm -f /etc/zextras/service-discover/carbonio-tasks-db.env /etc/zextras/service-discover/carbonio-tasks-db.hcl.bak
  fi

  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
  fi
}
